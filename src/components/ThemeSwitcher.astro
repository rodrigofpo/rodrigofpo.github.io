<div class="theme-switcher" role="group" aria-label="Tema do site">
  <button type="button" data-theme-choice="system" aria-label="Usar tema do sistema" title="Sistema">
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="13" rx="2"></rect><path d="M8 21h8M12 17v4"></path></svg>
  </button>
  <button type="button" data-theme-choice="light" aria-label="Usar tema claro" title="Claro">
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path></svg>
  </button>
  <button type="button" data-theme-choice="dark" aria-label="Usar tema escuro" title="Escuro">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.5 14.4A8.5 8.5 0 0 1 9.6 3.5 8.5 8.5 0 1 0 20.5 14.4Z"></path></svg>
  </button>
</div>

<script>
  const query = window.matchMedia('(prefers-color-scheme: dark)');
  const choices = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');

  const applyTheme = (preference: string) => {
    const resolved = preference === 'system' ? (query.matches ? 'dark' : 'light') : preference;
    document.documentElement.dataset.theme = resolved;
    document.documentElement.dataset.themePreference = preference;
    choices.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.themeChoice === preference));
    });
  };

  choices.forEach((button) => button.addEventListener('click', () => {
    const preference = button.dataset.themeChoice ?? 'system';
    if (preference === 'system') localStorage.removeItem('theme');
    else localStorage.setItem('theme', preference);
    applyTheme(preference);
  }));

  query.addEventListener('change', () => {
    if ((document.documentElement.dataset.themePreference ?? 'system') === 'system') applyTheme('system');
  });

  applyTheme(document.documentElement.dataset.themePreference ?? 'system');
</script>

<style>
  .theme-switcher { display: flex; padding: 3px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface) }
  button { width: 30px; height: 28px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 999px; color: var(--muted); background: transparent; cursor: pointer }
  button:hover { color: var(--text) }
  button[aria-pressed='true'] { color: var(--bg); background: var(--lime) }
  button:focus-visible { outline: 2px solid var(--lime); outline-offset: 2px }
  svg { width: 15px; height: 15px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round }
</style>
