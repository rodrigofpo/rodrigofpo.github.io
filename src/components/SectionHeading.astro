---
interface Props {
  eyebrow: string;
  title: string;
  href?: string;
  linkLabel?: string;
  inline?: boolean;
}

const { eyebrow, title, href, linkLabel, inline = false } = Astro.props;
---

<div class:list={['section-heading', { inline }] }>
  <div>
    <p class="kicker">{eyebrow}</p>
    <h2>{title}</h2>
  </div>
  {href && linkLabel && <a class="text-link" href={href}>{linkLabel} <span aria-hidden="true">→</span></a>}
</div>

<style>
  .section-heading { margin-bottom: 52px }
  h2 { font-family: var(--serif), serif; font-size: clamp(44px, 6vw, 74px); font-weight: 400; line-height: 1; margin: 18px 0 0 }
  .inline { display: flex; justify-content: space-between; align-items: end }
  .text-link { font-size: 14px; border-bottom: 1px solid var(--line); padding-bottom: 6px }
  .text-link span { color: var(--lime); margin-left: 8px }
  @media (max-width: 720px) {
    .inline { display: block }
    .inline .text-link { display: inline-block; margin-top: 25px }
  }
</style>
