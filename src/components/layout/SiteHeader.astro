---
import ThemeSwitcher from '../ThemeSwitcher.astro';
---

<header class="site-header">
  <nav class="nav shell" aria-label="Navegação principal">
    <a class="brand" href="/" aria-label="Página inicial">r<span>.</span></a>
    <div class="nav-links">
      <a href="/#projetos">Projetos</a>
      <a href="/blog/">Blog</a>
      <a href="/#sobre">Sobre</a>
    </div>
    <div class="nav-actions">
      <ThemeSwitcher />
      <a class="nav-cta" href="mailto:rodrigofpo@gmail.com">Vamos conversar <span aria-hidden="true">↗</span></a>
    </div>
  </nav>
</header>

<style>
  .site-header { position: relative; border-bottom: 1px solid var(--line) }
  .nav { height: 88px; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center }
  .brand { font-size: 30px; font-weight: 600 }
  .brand span { color: var(--lime) }
  .nav-links { display: flex; gap: 34px; font-size: 14px }
  .nav-links a { color: var(--muted); transition: color .2s }
  .nav-links a:hover { color: var(--text) }
  .nav-actions { justify-self: end; display: flex; align-items: center; gap: 24px }
  .nav-cta { font-size: 14px; border-bottom: 1px solid var(--lime); padding-bottom: 3px }
  @media (max-width: 720px) {
    .nav { grid-template-columns: 1fr auto }
    .nav-links { display: none }
    .nav-cta { font-size: 12px }
  }
</style>
