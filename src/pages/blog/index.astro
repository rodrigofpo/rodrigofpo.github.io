---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/blog/PostRow.astro';
import {getPublishedPosts} from '../../lib/posts';

const posts = await getPublishedPosts();
---
<BaseLayout title="Blog — Rodrigo F. P. Oliveira"
            description="Notas sobre desenvolvimento, tecnologia, projetos e aprendizados.">
    <section class="page-intro shell">
        <p class="kicker">Caderno de notas</p>
        <h1>Ideias, descobertas<br/>e <em>coisas em construção.</em></h1>
        <p>Textos sobre desenvolvimento, tecnologia e os aprendizados que aparecem no caminho.</p>
    </section>
    <section class="blog-index shell">
        {posts.map((post, index) => <PostRow post={post} index={index} variant="complete" />)}
    </section>
</BaseLayout>
