---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import PostRow from '../components/blog/PostRow.astro';
import ProjectCard from '../components/projects/ProjectCard.astro';
import { projects } from '../data/projects';
import { getPublishedPosts } from '../lib/posts';
import { getHomeStructuredData } from '../lib/seo';

const posts = await getPublishedPosts({ limit: 3 });
---

<BaseLayout jsonLd={getHomeStructuredData()}>
  <section class="hero shell">
    <div class="eyebrow"><span></span> Disponível para bons projetos</div>
    <h1>Transformo ideias em<br /><em>experiências digitais.</em></h1>
    <div class="hero-bottom">
      <p>Olá, sou Rodrigo — desenvolvedor de software. Gosto de construir produtos úteis, interfaces cuidadosas e sistemas que fazem sentido.</p>
      <a class="circle-link" href="#projetos" aria-label="Ver projetos"><span>↓</span></a>
    </div>
  </section>

  <section class="section shell" id="projetos">
    <SectionHeading eyebrow="01 / Projetos selecionados" title="Trabalho recente" />
    <div class="project-grid">
      {projects.map((project, index) => <ProjectCard project={project} index={index} />)}
    </div>
  </section>

  <section class="section journal shell">
    <SectionHeading eyebrow="02 / Caderno de notas" title="Escrevendo para pensar" href="/blog/" linkLabel="Todos os textos" inline />
    <div class="post-list">
      {posts.map(post => <PostRow post={post} />)}
    </div>
  </section>

  <section class="about shell" id="sobre">
    <p class="kicker">03 / Sobre</p>
    <div class="about-grid">
      <h2>Curioso por natureza.<br /><em>Prático por escolha.</em></h2>
      <div>
        <p>Sou um desenvolvedor que aprecia tanto a clareza de um bom código quanto a sutileza de uma boa interface. Este site é meu espaço para mostrar o que construo e registrar o que aprendo pelo caminho.</p>
        <p>Fora das telas, estou provavelmente descobrindo alguma coisa nova — e pensando em como transformá-la no próximo projeto.</p>
      </div>
    </div>
  </section>

  <section class="contact shell" id="contato">
    <p>Tem uma ideia em mente?</p>
    <a href="mailto:rodrigofpo@gmail.com">Vamos criar algo juntos <span>↗</span></a>
  </section>
</BaseLayout>
